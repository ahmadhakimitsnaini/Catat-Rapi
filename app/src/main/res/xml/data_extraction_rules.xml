<?xml version="1.0" encoding="utf-8"?>
<!--
   NFR-S5: Mengecualikan seluruh berkas database dan preferensi dari cloud backup maupun device transfer otomatis.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
